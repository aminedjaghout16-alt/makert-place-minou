// ─────────────────────────────────────────────
// MarketHub — Prisma Schema
// PostgreSQL via Supabase
// ─────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ───────────────────────────────────
enum Role {
  USER
  SELLER
  ADMIN
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique @map("firebase_uid")
  username    String
  email       String   @unique
  avatar      String?
  bio         String?
  role        Role     @default(USER)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  listings        Listing[]
  favorites       Favorite[]
  reviewsGiven    Review[]       @relation("reviewsGiven")
  reviewsReceived Review[]       @relation("reviewsReceived")
  reports         Report[]
  notifications   Notification[]
  analytics       Analytics[]

  @@map("users")
}

// ── Listings ────────────────────────────────
enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  SOLD
  FLAGGED
  REMOVED
}

model Listing {
  id          String        @id @default(cuid())
  sellerId    String        @map("seller_id")
  title       String
  description String
  price       Float
  category    String
  location    String
  images      String[]
  tags        String[]      @default([])
  status      ListingStatus @default(PENDING)
  featured    Boolean       @default(false)
  views       Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  seller    User        @relation(fields: [sellerId], references: [id])
  favorites Favorite[]
  reviews   Review[]
  reports   Report[]
  analytics Analytics[]

  @@index([category])
  @@index([status])
  @@index([sellerId])
  @@map("listings")
}

// ── Categories ──────────────────────────────
model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  icon     String
  color    String
  count    Int     @default(0)
  parentId String? @map("parent_id")

  @@map("categories")
}

// ── Favorites ───────────────────────────────
model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([userId, listingId])
  @@map("favorites")
}

// ── Reviews ─────────────────────────────────
model Review {
  id        String   @id @default(cuid())
  authorId  String   @map("author_id")
  sellerId  String   @map("seller_id")
  listingId String   @map("listing_id")
  rating    Int
  comment   String
  createdAt DateTime @default(now()) @map("created_at")

  author  User    @relation("reviewsGiven", fields: [authorId], references: [id])
  seller  User    @relation("reviewsReceived", fields: [sellerId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@map("reviews")
}

// ── Conversations (messages metadata) ───────
model Conversation {
  id             String   @id @default(cuid())
  participantIds String[] @map("participant_ids")
  lastMessage    String?  @map("last_message")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  // Real-time messages are stored in Firestore
  // This model tracks conversation metadata in PostgreSQL

  @@map("conversations")
}

// ── Reports ─────────────────────────────────
enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String       @map("reporter_id")
  listingId   String?      @map("listing_id")
  reason      String
  description String
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")

  reporter User     @relation(fields: [reporterId], references: [id])
  listing  Listing? @relation(fields: [listingId], references: [id])

  @@map("reports")
}

// ── Notifications ───────────────────────────
enum NotificationType {
  MESSAGE
  FAVORITE
  REVIEW
  LISTING_SOLD
  PRICE_DROP
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@map("notifications")
}

// ── Analytics ───────────────────────────────
model Analytics {
  id        String   @id @default(cuid())
  listingId String?  @map("listing_id")
  userId    String?  @map("user_id")
  eventType String   @map("event_type") // view, favorite, click, purchase
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing? @relation(fields: [listingId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([eventType])
  @@index([createdAt])
  @@map("analytics")
}
